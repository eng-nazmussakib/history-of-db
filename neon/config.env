# Neon target for history-of-db. Not secret: credentials are fetched at run time
# by the Neon CLI and written to ../.env.production (git-ignored).
NEON_PROJECT_ID=summer-snow-40001533   # project "history-of-db", aws-ap-southeast-1, PostgreSQL 18
NEON_BRANCH=production
NEON_DATABASE=neondb   # the branch default: `neon env pull` / `neon deploy` in history-of-app always target it
